# Copia este archivo como .env y completa los valores. El archivo .env NO se versiona.
# Todas las variables del backend usan el prefijo SAAPRE_.

SAAPRE_ENV=development            # development | test | production

# Base de datos (en producción debe incluir sslmode=require)
SAAPRE_DATABASE_URL=postgresql+psycopg://saapre_app:CAMBIAR@localhost:5432/saapre

# Claves de las APIs externas (claves gratuitas de desarrollador)
SAAPRE_RIOT_API_KEY=
SAAPRE_FACEIT_API_KEY=

# Clave para los endpoints administrativos (recolección y reentrenamiento).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SAAPRE_ADMIN_API_KEY=

# CORS: orígenes permitidos del dashboard, separados por coma
SAAPRE_CORS_ORIGINS=http://localhost:5173

# Límites de peticiones por IP y minuto
SAAPRE_RATE_LIMIT_PER_MINUTE=60
SAAPRE_ADMIN_RATE_LIMIT_PER_MINUTE=10

# Semilla para entrenamientos reproducibles (RNF-08)
SAAPRE_RANDOM_SEED=42

# --- Solo para docker-compose (PostgreSQL local) ---
POSTGRES_PASSWORD=
SAAPRE_APP_PASSWORD=
SAAPRE_MIGRATOR_PASSWORD=
